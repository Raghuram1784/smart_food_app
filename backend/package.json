{
  "name": "food-delivery-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:hyd": "tsx prisma/seed_hyd.ts",
    "db:verify": "tsx scripts/verify.ts",
    "test": "tsx --test test/unit.test.ts test/food-finder.unit.test.ts test/bill-split.unit.test.ts test/scheduling.unit.test.ts test/tracking.unit.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e.test.ts test/pricing.e2e.test.ts test/auth.e2e.test.ts test/commerce.e2e.test.ts test/rider-presence.e2e.test.ts test/delivery-location.e2e.test.ts test/catalog-nutrition.e2e.test.ts test/food-finder.e2e.test.ts test/locality-coverage.e2e.test.ts test/group-ordering.e2e.test.ts test/scheduling.e2e.test.ts test/tracking.e2e.test.ts",
    "db:seed:pricing": "tsx prisma/seed_pricing.ts",
    "db:seed:hosted": "tsx scripts/seed-hosted.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-demo.ts",
    "db:seed:auth": "tsx prisma/seed_auth.ts",
    "test:auth": "tsx --test test/auth.e2e.test.ts"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/websockets": "^11.2.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
