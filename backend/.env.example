NODE_ENV=development
# Razorpay TEST only. Never put the secret in Flutter or source control.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=
# Optional until a public HTTPS webhook endpoint is configured.
RAZORPAY_WEBHOOK_SECRET=
PORT=5000
DATABASE_URL="postgresql://food_app_user:YOUR_PASSWORD@localhost:5432/food_delivery_dev?schema=public"
DIRECT_URL="postgresql://food_app_user:YOUR_PASSWORD@localhost:5432/food_delivery_dev?schema=public"
API_PREFIX=api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Optional one-time setup only, never used by the application:
# POSTGRES_ADMIN_URL=postgresql://postgres:YOUR_EXISTING_PASSWORD@localhost:5432/postgres
# TEST_DATABASE_URL=postgresql://food_app_user:YOUR_PASSWORD@localhost:5432/food_delivery_test?schema=public

# Development-only demo accounts; never enable in production.
DEMO_AUTH_ENABLED=false
DEMO_CHECKOUT_ENABLED=false
# Separate opt-in: only development/test no-payment orders may be fulfilled.
DEMO_FULFILLMENT_ENABLED=false
AUTH_SESSION_HOURS=12
# Secure handover: generate two independent 32-byte random hex keys server-side.
# Do not copy literal placeholder keys; see docs/phase7_1/BACKEND_HANDOFF.md.
# Omit the keys locally, then run: npx tsx scripts/setup-handover-keys.ts
# HANDOVER_HMAC_KEY=
# HANDOVER_ENCRYPTION_KEY=
HANDOVER_KEY_VERSION=v1
HANDOVER_TTL_SECONDS=600
HANDOVER_REGENERATE_SECONDS=60
# Run npm run auth:bootstrap to generate local passwords, then db:seed:auth.
