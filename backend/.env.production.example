# Production / hosted demo environment — NAMES AND SAFE DEFAULTS ONLY. Never commit real values.
# Enter secrets in the host's secret store (Render dashboard). Generate new values; never reuse development ones.

NODE_ENV=production
PORT=                       # provided by the host
API_PREFIX=api/v1
LOG_LEVEL=info
CORS_ORIGINS=               # e.g. https://<your-domain> (comma-separated, no wildcards)
APP_LINK_BASE=              # https://<your-domain>, used for group invite links

# Separate deployment database (never food_delivery_dev / food_delivery_test)
DATABASE_URL=               # pooled connection string
DIRECT_URL=                 # direct connection string, used by prisma migrate deploy

AUTH_SESSION_HOURS=12

# Secure OTP handover: two DIFFERENT 64-hex-character keys
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HANDOVER_HMAC_KEY=
HANDOVER_ENCRYPTION_KEY=
HANDOVER_KEY_VERSION=v1
HANDOVER_TTL_SECONDS=600
HANDOVER_REGENERATE_SECONDS=60

# AI food finder (new key restricted to this project)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=
FINDER_RATE_PER_MINUTE=

# Payments: Razorpay TEST mode keys for the hackathon (no real money)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Hosted demo only: lets NODE_ENV=production accept Razorpay TEST payments. Only rzp_test_ keys are
# ever accepted (live keys are refused), so no real money can be collected. Demo no-payment checkout
# and the test webhook stay disabled in production regardless of this flag.
PAYMENTS_TEST_MODE_ENABLED=false

# F4 road routing: 'none' = clearly labelled estimates; 'osrm' needs an approved OSRM-compatible server
# (the public OSRM demo server is NOT for production use)
ROUTING_PROVIDER=none
ROUTING_BASE_URL=

# Demo shortcuts: keep disabled in production. Demo (no-payment) checkout is refused when NODE_ENV=production.
DEMO_AUTH_ENABLED=false
DEMO_CHECKOUT_ENABLED=false
DEMO_FULFILLMENT_ENABLED=false
# SCHEDULE_DEMO_FAST must not be set (ignored outside development anyway)

# Rider earnings: platform commission on delivery earnings, in basis points (1000 = 10%)
RIDER_COMMISSION_BPS=1000
